  cuttingJobs    CuttingJob[]
  reservations   MaterialReservation[]
  warrantyClaims WarrantyClaim[]      @relation("RMARemakeJob")

  @@index([orderId])
  @@index([status, currentStage])
  @@map("production_jobs")
}

model ProductionStageLog {
  id              String          @id @default(uuid()) @db.Uuid
  productionJobId String          @map("production_job_id") @db.Uuid
