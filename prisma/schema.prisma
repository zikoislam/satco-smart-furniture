model Enquiry {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String?       @map("company_id") @db.Uuid
  customerId        String?       @map("customer_id") @db.Uuid
  contactPhone      String        @map("contact_phone") @db.VarChar(20)
  contactName       String?       @map("contact_name") @db.VarChar(255)
  otpVerified       Boolean       @default(false) @map("otp_verified")
  source            String        @default("WEB_CONFIGURATOR") @db.VarChar(50)
  configSnapshotJson Json         @map("config_snapshot_json")
  recoveryToken     String?       @unique @map("recovery_token") @db.VarChar(128)
  recoveryMetaJson  Json?         @map("recovery_meta_json")
  status            EnquiryStatus @default(NEW)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customer          User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quotations        Quotation[]

  @@index([contactPhone])
  @@index([status])
  @@map("enquiries")
}

model Quotation {
  id                    String          @id @default(uuid()) @db.Uuid
  companyId             String          @map("company_id") @db.Uuid
  enquiryId             String?         @map("enquiry_id") @db.Uuid
  customerId            String          @map("customer_id") @db.Uuid
  pricingRuleId         String          @map("pricing_rule_id") @db.Uuid
  quoteNumber           String          @unique @map("quote_number") @db.VarChar(50)
  revisionTag           String          @default("R1") @map("revision_tag") @db.VarChar(16)
  parentQuotationId     String?         @map("parent_quotation_id") @db.Uuid
  status                QuotationStatus @default(DRAFT)
  netSubtotalSar        Decimal         @map("net_subtotal_sar") @db.Decimal(12, 4)
  discountPercent       Decimal         @default(0.00) @map("discount_percent") @db.Decimal(5, 2)
  discountSar           Decimal         @default(0.0000) @map("discount_sar") @db.Decimal(12, 4)
  vatAmountSar          Decimal         @map("vat_amount_sar") @db.Decimal(12, 4)
  grandTotalSar         Decimal         @map("grand_total_sar") @db.Decimal(12, 4)
  discountApprovedBy    String?         @map("discount_approved_by") @db.Uuid
  pricingSnapshotJson   Json            @map("pricing_snapshot_json")
  portalTokenSignature  String?         @unique @map("portal_token_signature") @db.VarChar(255)
  expiresAt             DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  company               Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  enquiry               Enquiry?        @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  customer              User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pricingRule           PricingRule     @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)
  items                 QuotationItem[]
  order                 Order?

  @@index([quoteNumber])
  @@index([customerId, status])
  @@map("quotations")
}

model QuotationItem {
  id                  String          @id @default(uuid()) @db.Uuid
  quotationId         String          @map("quotation_id") @db.Uuid
  templateId          String          @map("template_id") @db.Uuid
  configuredWidthMm   Int             @map("configured_width_mm")
  configuredHeightMm  Int             @map("configured_height_mm")
  configuredDepthMm   Int             @map("configured_depth_mm")
  configurationJson   Json            @map("configuration_json")
  quantity            Int             @default(1)
  unitPriceSar        Decimal         @map("unit_price_sar") @db.Decimal(12, 4)
  totalPriceSar       Decimal         @map("total_price_sar") @db.Decimal(12, 4)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  quotation           Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  template            ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@map("quotation_items")
}

model MilestonePayment {
  id             String                 @id @default(uuid()) @db.Uuid
  orderId        String                 @map("order_id") @db.Uuid
  milestone      MilestoneNumber        @map("milestone")
  percentage     Decimal                @db.Decimal(5, 2)
  amountSar      Decimal                @map("amount_sar") @db.Decimal(12, 4)
