# Database connection (PostgreSQL in KSA Region)
DATABASE_URL="postgresql://satco_admin:Secr3tPassword!@localhost:5432/satco_furniture_db?schema=public"

# App & Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_LOCALE="ar"
SUPPORTED_LOCALES="ar,en"

# JWT Authentication
JWT_SECRET="satco-super-secret-jwt-key-ksa-32-chars-min"
JWT_EXPIRES_IN="7d"

# Redis Caching & Queue (Upstash or Redis Cloud in me-central2)
REDIS_URL="redis://localhost:6379"

# ZATCA e-Invoicing Phase 2 (Sandbox)
ZATCA_ENV="simulation"
ZATCA_PORTAL_URL="https://gw-fatoora.zatca.gov.sa"
ZATCA_VAT_PERCENTAGE="15.0000"
ZATCA_VAT_NUMBER="300000000000003"
ZATCA_CERTIFICATE_SECRET="mock_certificate_secret"

# SMS OTP Provider (Unifonic / Taqnyat KSA)
SMS_GATEWAY_API_KEY="mock_sms_api_key"
SMS_GATEWAY_SENDER_ID="SATCO"

# Payment Gateways (Mada, Apple Pay, Tabby, Tamara)
PAYMENT_MOCK_MODE="true"
MOYASAR_API_KEY="mock_moyasar_key"
TABBY_PUBLIC_KEY="mock_tabby_key"
TAMARA_API_KEY="mock_tamara_key"

# Storage (GCS / S3 in Dammam me-central2)
GCS_BUCKET_NAME="satco-furniture-production"
GCS_PROJECT_ID="satco-cloud-ksa"

# Homag CNC Bridge
FACTORY_BRIDGE_API_KEY="satco-homag-bridge-secret-key"
